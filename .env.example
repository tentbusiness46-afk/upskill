# ============================================================
# UPSKILL10X — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Auth / JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# --- Admin bootstrap account (created automatically on first db:init) ---
ADMIN_EMAIL=admin@upskill10x.com
ADMIN_PASSWORD=change_this_immediately
ADMIN_NAME=Upskill10x Admin

# --- Pricing ---
# Course prices and the All-Access Pass price are edited in the admin panel.
# These two only seed the bundle price on the very first db:init.
BUNDLE_PRICE=2999
BUNDLE_MRP=11999

# --- SQLite ---
# Local/VPS/Render deployments: path to the sqlite file (persists on disk)
DATABASE_PATH=./data/upskill10x.db

# --- Razorpay ---
# From Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# From Razorpay Dashboard > Settings > Webhooks (create a webhook, use this as the "Secret")
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Cloudflare R2 (for reference only — used by the manual upload workflow,
#     not called directly by the server. See README for details) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=upskill10x-videos
R2_PUBLIC_BASE_URL=https://videos.upskill10x.com
# Only needed if you later add server-side signed URLs:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Email (used by admin panel "email coupon" action — optional, SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Upskill10x <no-reply@upskill10x.com>"
